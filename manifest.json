{
    "manifest_version":  3,
    "name":  "AMP-Manager",
    "version":  "0.29.0.0",
    "version_name":  "V0.29",
    "description":  "AMP Manager 2026806",
    "permissions":  [
                        "tabs",
                        "storage",
                        "alarms",
                        "windows",
                        "notifications",
                        "contextMenus",
                        "activeTab",
                        "scripting",
                        "management",
                        "system.display",
                        "clipboardRead",
                        "clipboardWrite",
                        "webNavigation",
                        "nativeMessaging",
                        "declarativeContent",
                        "declarativeNetRequestWithHostAccess",
                        "offscreen",
                        "downloads"
                    ],
    "options_page":  "Options/options.html",
    "background":  {
                       "service_worker":  "background.js"
                   },
    "host_permissions":  [
                             "\u003call_urls\u003e"
                         ],
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://www.instagram.com/direct/t/*",
                                                "https://www.facebook.com/messages/t/*"
                                            ],
                                "js":  [
                                           "AMOpenLink/AM-AutoAnswerBridge.js"
                                       ],
                                "run_at":  "document_start",
                                "all_frames":  true
                            },
                            {
                                "matches":  [
                                                "https://www.instagram.com/direct/t/*",
                                                "https://www.facebook.com/messages/t/*"
                                            ],
                                "js":  [
                                           "AMOpenLink/page-hook.js"
                                       ],
                                "run_at":  "document_start",
                                "world":  "MAIN",
                                "all_frames":  true
                            },
                            {
                                "matches":  [
                                                "https://www.facebook.com/messages/t/*"
                                            ],
                                "js":  [
                                           "Shared/vendor/xlsx.full.min.js",
                                           "AMPManager/FMcontent.js"
                                       ]
                            },
                            {
                                "matches":  [
                                                "https://www.messenger.com/groupcall/*",
                                                "https://www.facebook.com/groupcall/*"
                                            ],
                                "js":  [
                                           "AMPManager/CLcontent.js"
                                       ]
                            },
                            {
                                "matches":  [
                                                "https://www.instagram.com/direct/t/*"
                                            ],
                                "js":  [
                                           "AMPManager/IGcontent.js"
                                       ]
                            },
                            {
                                "matches":  [
                                                "https://meet.google.com/*"
                                            ],
                                "js":  [
                                           "AMPManager/GMcontent.js"
                                       ]
                            },
                            {
                                "matches":  [
                                                "\u003call_urls\u003e"
                                            ],
                                "js":  [
                                           "PictureInPicture/PiPcontent.js"
                                       ],
                                "run_at":  "document_idle",
                                "all_frames":  true
                            }
                        ],
    "action":  {
                   "default_icon":  {
                                        "16":  "icons/AMPicon16.png"
                                    }
               },
    "icons":  {
                  "16":  "icons/AMPicon16.png",
                  "48":  "icons/AMPicon48.png",
                  "128":  "icons/AMPicon128.png"
              },
    "commands":  {
                     "toggle_popup":  {
                                          "suggested_key":  {
                                                                "default":  "Alt+Z"
                                                            },
                                          "description":  "切换弹窗/标签页视图"
                                      },
                     "toggleAllTabsMute":  {
                                               "suggested_key":  {
                                                                     "default":  "Alt+M"
                                                                 },
                                               "description":  "开启/静音所有标签页"
                                           },
                     "enter_pip_primary":  {
                                               "suggested_key":  {
                                                                     "default":  "Alt+P"
                                                                 },
                                               "description":  "对当前页面的主视频进入画中画"
                                           }
                 },
    "declarative_net_request":  {
                                    "rule_resources":  [
                                                           {
                                                               "id":  "PIPrules_1",
                                                               "enabled":  true,
                                                               "path":  "PIPrules.json"
                                                           }
                                                       ]
                                },
    "web_accessible_resources":  [
                                     {
                                         "resources":  [
                                                           "icons/*.png",
                                                           "icons/*.gif"
                                                       ],
                                         "matches":  [
                                                         "\u003call_urls\u003e"
                                                     ]
                                     }
                                 ]
}
